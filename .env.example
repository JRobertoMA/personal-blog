; Copia este archivo como .env y súbelo FUERA de la carpeta pública del sitio
; (p. ej. un nivel por encima de la carpeta a la que apunta tu dominio en IONOS).
; Usa comillas si la contraseña tiene caracteres especiales.
DB_HOST=dbXXXXXXXXX.hosting-data.io
DB_NAME=dbsXXXXXXXX
DB_USER=dbuXXXXXXXX
DB_PASS="cambia-esto"
UPLOAD_PATH=uploads/media
MAX_UPLOAD_BYTES=10485760
; Opcional: archivo donde la API anota sus errores (en IONOS el log de PHP no es
; accesible). Ruta relativa = junto a este .env, fuera de la carpeta pública.
; LOG_FILE=personal-blog-errors.log
